# Copy to `.env` (git-ignored) and fill in real values. NOTHING here has a working
# default - the stack refuses to start without these set.

DMRV_ENVIRONMENT=dev

# Database
DMRV_DB_USER=dmrv
DMRV_DB_NAME=dmrv
# Generate a strong value, do NOT reuse across environments:
#   openssl rand -base64 24
DMRV_DB_PASSWORD=CHANGE_ME_generate_a_strong_password

# Auth. MUST be >=32 random chars. Generate with:
#   openssl rand -base64 48
DMRV_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Comma-separated allow-list of browser origins permitted to call the API.
DMRV_CORS_ALLOW_ORIGINS=http://localhost:8080

# Storage: "local" for this compose; "s3" (with DMRV_S3_BUCKET) in cloud.
DMRV_STORAGE_BACKEND=local

# Gunicorn worker processes for the backend.
WEB_CONCURRENCY=2

# Google Earth Engine (RS/AGB proxy, scripts/gee_phase1_agb_proxy.py).
# DMRV_GEE_CREDENTIALS_PATH is a HOST path to your own `earthengine authenticate`
# credentials file (default location: ~/.config/earthengine/credentials) - it is
# bind-mounted read-only into the backend container, never baked into the image.
# That file must be readable by uid 10001 (the container's non-root user), e.g.
# `chmod 644` it.
DMRV_GEE_PROJECT_ID=CHANGE_ME_your_gee_cloud_project_id
DMRV_GEE_CREDENTIALS_PATH=CHANGE_ME_path_to_your_earthengine_credentials_file

# CDSE / VNV Pipeline (Phase 1: Sentinel ingestion, app/services/cdse_ingestion.py).
# Not required to start this stack - nothing calls this module yet (see its
# docstring) - but required for that module to work at all once something does.
# Two DIFFERENT CDSE credential types:
#   OAuth client credentials (STAC catalog search) - register a client at
#   https://shapps.dataspace.copernicus.eu/dashboard/
DMRV_CDSE_CLIENT_ID=CHANGE_ME_your_cdse_oauth_client_id
DMRV_CDSE_CLIENT_SECRET=CHANGE_ME_your_cdse_oauth_client_secret
#   S3 access/secret key pair (windowed pixel reads from eodata.dataspace.copernicus.eu) -
#   generate at the same dashboard, under "S3 credentials". NOT the same keys as the
#   OAuth client above.
DMRV_CDSE_S3_ACCESS_KEY=CHANGE_ME_your_cdse_s3_access_key
DMRV_CDSE_S3_SECRET_KEY=CHANGE_ME_your_cdse_s3_secret_key
